<?xml version="1.0" encoding="utf-8"?>
<!-- 应用不备份任何数据（团队数据在 DSH 主机上，不在手机），规则保持最小。 -->
<data-extraction-rules>
    <cloud-backup disableIfNoEncryptionCapabilities="true">
        <exclude domain="root" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
    </device-transfer>
</data-extraction-rules>
